<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TBC Suite" parallel="classes" thread-count="3">

    <test name="Chrome Desktop">
        <parameter name="resolution" value="1440 x 900"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="platform" value="desktop"/>
        <classes>
            <class name="ge.tbc.testautomation.tests.CurrencyCalculatorWithValidDataTest"/>
            <class name="ge.tbc.testautomation.tests.CurrencyCalculatorWithInvalidDataTest"/>
            <class name="ge.tbc.testautomation.tests.LoanCalculatorWithValidDataTest"/>
            <class name="ge.tbc.testautomation.tests.LoanCalculatorWithNonvalidDataTest"/>
            <class name="ge.tbc.testautomation.tests.SearchBranchWithValidDataTest"/>
            <class name="ge.tbc.testautomation.tests.SearchBranchWithNonvalidDataTest"/>
            <class name="ge.tbc.testautomation.tests.LocationsFilterTest"/>
            <class name="ge.tbc.testautomation.tests.TbcCardOrderStartTest"/>
        </classes>
    </test>

    <test name="Chrome Mobile">
        <parameter name="resolution" value="390x844"/>
        <parameter name="browser" value="chrome"/>
        <parameter name="platform" value="mobile"/>
        <classes>
            <class name="ge.tbc.testautomation.tests.CurrencyCalculatorWithValidDataTest"/>
            <class name="ge.tbc.testautomation.tests.CurrencyCalculatorWithInvalidDataTest"/>
            <class name="ge.tbc.testautomation.tests.LoanCalculatorWithValidDataTest"/>
            <class name="ge.tbc.testautomation.tests.LoanCalculatorWithNonvalidDataTest"/>
            <class name="ge.tbc.testautomation.tests.SearchBranchWithValidDataTest"/>
            <class name="ge.tbc.testautomation.tests.SearchBranchWithNonvalidDataTest"/>
            <class name="ge.tbc.testautomation.tests.LocationsFilterTest"/>
            <class name="ge.tbc.testautomation.tests.TbcCardOrderStartTest"/>
            <class name="ge.tbc.testautomation.tests.BurgerMenuTest"/>
        </classes>
    </test>

</suite>